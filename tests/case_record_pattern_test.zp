record Address {
    city: Int,
}

record User {
    id: Int,
    address: Address,
}

struct Point {
    x: Int,
    y: Int,
}

enum Status { Active, Inactive }

record Account {
    status: Status,
    balance: Int,
}

fun readUser(user: User) Int {
    case user {
        User { id, address: Address { city } } {
            return id + city;
        }
    }
}

fun readPoint(point: Point) Int {
    case point {
        Point { x: 0 } {
            return 100;
        }
        Point { x, y } {
            return x + y;
        }
    }
}

fun readAccount(account: Account) Int {
    case account {
        Account { status: Status.Active, balance } { return balance; }
        Account { balance } { return 0 - balance; }
    }
}

fun main() Int {
    var user: User = User{id: 2, address: Address{city: 40}};
    var point: Point = Point{x: 10, y: 20};
    if readUser(user) != 42 { return 1; }
    if readPoint(point) != 30 { return 2; }
    var origin: Point = Point{x: 0, y: 99};
    if readPoint(origin) != 100 { return 3; }
    var active: Account = Account{status: Status.Active, balance: 7};
    var inactive: Account = Account{status: Status.Inactive, balance: 7};
    if readAccount(active) != 7 { return 4; }
    if readAccount(inactive) != -7 { return 5; }
    return 0;
}
