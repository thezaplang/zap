struct User {
    id: Int,
    score: Int,
}

enum Result { Empty, Value(User) }

record Address {
    city: Int,
}

record Profile {
    id: Int,
    address: Address,
}

enum ProfileResult { Empty, Value(Profile) }

enum State { Active, Inactive }

record StatePayload {
    state: State,
}

enum StateResult { Empty, Value(StatePayload) }

fun read(result: Result) Int {
    case result {
        Result.Value(User { id, score }) { return id + score; }
        Result.Empty() { return 0; }
    }
}

fun classify(result: ProfileResult) Int {
    case result {
        ProfileResult.Value(Profile {
            id: 1,
            address: Address { city: 40 },
        }) { return 1; }
        ProfileResult.Value(Profile { id, address: Address { city } }) {
            return id + city;
        }
        ProfileResult.Empty() { return 0; }
    }
}

fun classifyState(result: StateResult) Int {
    case result {
        StateResult.Value(StatePayload { state: State.Active }) { return 1; }
        StateResult.Value(StatePayload { state: State.Inactive }) { return 2; }
        StateResult.Empty() { return 0; }
        else { return -1; }
    }
}

fun main() Int {
    if read(Result.Value((User{id: 2, score: 40}))) != 42 { return 1; }
    if read(Result.Empty()) != 0 { return 2; }
    var exact: Profile = Profile{id: 1, address: Address{city: 40}};
    var other: Profile = Profile{id: 2, address: Address{city: 40}};
    var wrongCity: Profile = Profile{id: 1, address: Address{city: 41}};
    if classify(ProfileResult.Value((exact))) != 1 { return 3; }
    if classify(ProfileResult.Value((other))) != 42 { return 4; }
    if classify(ProfileResult.Empty()) != 0 { return 5; }
    if classify(ProfileResult.Value((wrongCity))) != 42 { return 6; }
    var active: StatePayload = StatePayload{state: State.Active};
    var inactive: StatePayload = StatePayload{state: State.Inactive};
    if classifyState(StateResult.Value((active))) != 1 { return 7; }
    if classifyState(StateResult.Value((inactive))) != 2 { return 8; }
    return 0;
}
