import "std/json";

fun parseFailsWith(text: String, kind: json.ErrorKind) Bool {
    var value: json.Value = json.parse(text) or err {
        return err.kind == kind && err.position >= 0;
    };
    return false;
}

fun parseDepthFails() Bool {
    var value: json.Value = json.parse("[[]]", 1) or err {
        return err.kind == json.ErrorKind.NestingTooDeep;
    };
    return false;
}

fun invalidDepthFails() Bool {
    var value: json.Value = json.parse("null", 0) or err {
        return err.kind == json.ErrorKind.InvalidDepth;
    };
    return false;
}

fun missingKeyFails() Bool {
    var object: json.Object = new json.Object();
    var value: json.Value = object.get("missing") or err {
        return err.kind == json.ErrorKind.MissingKey && err.position == -1;
    };
    return false;
}

fun typeMismatchFails() Bool!json.Error {
    var value: json.Value = json.parse("true")?;
    var text: String = value.asString() or err {
        return err.kind == json.ErrorKind.TypeMismatch;
    };
    return false;
}

fun boundsFail() Bool {
    var array: json.Array = new json.Array();
    var value: json.Value = array.at(0) or err {
        return err.kind == json.ErrorKind.IndexOutOfBounds;
    };
    return false;
}

fun integerConversionFails() Bool!json.Error {
    var value: json.Value = json.parse("1e2")?;
    var number: Int = value.asInt() or err {
        return err.kind == json.ErrorKind.NumberConversion;
    };
    return false;
}

fun nonFiniteFails() Bool {
    var zero: Float64 = 0.0;
    var notANumber: Float64 = zero / zero;
    var value: json.Value = json.Value.number(notANumber) or err {
        return err.kind == json.ErrorKind.NonFiniteNumber;
    };
    return false;
}

fun cycleFails() Bool {
    var object: json.Object = new json.Object();
    object.put("self", object);
    var text: String = object.stringify(4) or err {
        return err.kind == json.ErrorKind.NestingTooDeep;
    };
    return false;
}

fun main() Int {
    if !parseFailsWith("", json.ErrorKind.UnexpectedEnd) { return 1; }
    if !parseFailsWith("01", json.ErrorKind.TrailingCharacters) { return 2; }
    if !parseFailsWith("1.", json.ErrorKind.InvalidNumber) { return 3; }
    if !parseFailsWith("true false", json.ErrorKind.TrailingCharacters) { return 4; }
    if !parseFailsWith("\"\\x\"", json.ErrorKind.InvalidEscape) { return 5; }
    if !parseFailsWith("\"\\ud800\"", json.ErrorKind.InvalidUnicodeEscape) { return 6; }
    if !parseDepthFails() || !invalidDepthFails() { return 7; }
    if !missingKeyFails() || !boundsFail() { return 8; }
    var mismatch: Bool = typeMismatchFails() or false;
    var conversion: Bool = integerConversionFails() or false;
    if !mismatch || !conversion { return 9; }
    if !nonFiniteFails() { return 10; }
    if !cycleFails() { return 11; }
    return 0;
}
