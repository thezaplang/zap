pub const PI: Float64 = 3.14159265358979323846;
pub const E: Float64 = 2.71828182845904523536;
pub const TAU: Float64 = 6.28318530717958647692;
pub const SQRT2: Float64 = 1.41421356237309504880;
pub const DEG_TO_RAD: Float64 = 0.01745329251994329577;
pub const RAD_TO_DEG: Float64 = 57.2957795130823208768;

pub ext fun sqrt(x: Float64) Float64;
pub ext fun floor(x: Float64) Float64;
pub ext fun ceil(x: Float64) Float64;
pub ext fun round(x: Float64) Float64;
pub ext fun trunc(x: Float64) Float64;
pub ext fun pow(x: Float64, y: Float64) Float64;
pub ext fun sin(x: Float64) Float64;
pub ext fun cos(x: Float64) Float64;
pub ext fun tan(x: Float64) Float64;
pub ext fun asin(x: Float64) Float64;
pub ext fun acos(x: Float64) Float64;
pub ext fun atan(x: Float64) Float64;
pub ext fun atan2(y: Float64, x: Float64) Float64;
pub ext fun exp(x: Float64) Float64;
pub ext fun log(x: Float64) Float64;
pub ext fun log10(x: Float64) Float64;
pub ext fun log2(x: Float64) Float64;

pub fun abs(x: Int) Int {
    if x < 0 {
        return -x;
    }
    return x;
}

pub fun abs(x: Float64) Float64 {
    if x < 0.0 {
        return -x;
    }
    return x;
}

pub fun abs(x: Float) Float {
    if x < 0.0 {
        return -x;
    }
    return x;
}

pub fun min(a: Int, b: Int) Int {
    if a < b {
        return a;
    }
    return b;
}

pub fun min(a: Float64, b: Float64) Float64 {
    if a < b {
        return a;
    }
    return b;
}

pub fun max(a: Int, b: Int) Int {
    if a > b {
        return a;
    }
    return b;
}

pub fun max(a: Float64, b: Float64) Float64 {
    if a > b {
        return a;
    }
    return b;
}

pub fun clamp(value: Int, low: Int, high: Int) Int {
    if value < low { return low; }
    if value > high { return high; }
    return value;
}

pub fun clamp(value: Float64, low: Float64, high: Float64) Float64 {
    if value < low { return low; }
    if value > high { return high; }
    return value;
}

pub fun sign(x: Int) Int {
    if x < 0 { return -1; }
    if x > 0 { return 1; }
    return 0;
}

pub fun sign(x: Float64) Float64 {
    if x < 0.0 { return -1.0; }
    if x > 0.0 { return 1.0; }
    return 0.0;
}

pub fun radToDeg(rad: Float64) Float64 {
    return rad * RAD_TO_DEG;
}
pub fun degToRad(deg: Float64) Float64 {
    return deg * DEG_TO_RAD;
}

pub fun gcd(a: Int, b: Int) Int {
    var x: Int = abs(a);
    var y: Int = abs(b);
    while y != 0 {
        var temp: Int = y;
        y = x % y;
        x = temp;
    }
    return x;
}

pub fun lcm(a: Int, b: Int) Int {
    if a == 0 || b == 0 { return 0; }
    return abs(a * b) / gcd(a, b);
}

pub fun isPowerOfTwo(n: Int) Bool {
    return n > 0 && (n & (n - 1)) == 0;
}

pub fun nextPowerOfTwo(n: Int) Int {
    if n <= 0 { return 1; }
    var p: Int = 1;
    var maxInt: Int = ((-1 as UInt) >> 1) as Int;
    while p < n {
        if p > maxInt / 2 {
            return 0;
        }
        p = p * 2;
    }
    return p;
}
